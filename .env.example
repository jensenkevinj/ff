# Server
# Which network address to listen on. 127.0.0.1 (the default) accepts connections from this machine only.
# 0.0.0.0 exposes the dashboard to every device on your local network (e.g. on a home server).
# There is no login, so never forward this port on your router.
HOST=127.0.0.1
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Sleeper (Step 2)
SLEEPER_LEAGUE_ID=
SLEEPER_USERNAME=

# ESPN (Step 3)
ESPN_LEAGUE_ID=
# Your team's number (teamId=… in your team page's URL). Required unless ESPN_SWID identifies you.
ESPN_TEAM_ID=
# Defaults to the current NFL season
ESPN_SEASON=
# Only needed for private leagues (copy from browser cookies on espn.com)
ESPN_S2=
ESPN_SWID=

# Yahoo (Step 4)
YAHOO_LEAGUE_ID=
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Must match the redirect URI registered on your Yahoo app exactly: `oob`, or an https URL
YAHOO_REDIRECT_URI=oob
